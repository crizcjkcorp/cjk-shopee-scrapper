
{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "Shopee Product Scraper",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "keywords": {
            "title": "Search Keywords",
            "type": "array",
            "description": "Daftar keyword produk yang ingin dicari di Shopee.",
            "editor": "stringList",
            "default": [
                "atomic habits",
                "the psychology of money"
            ],
            "prefill": [
                "atomic habits",
                "the psychology of money"
            ]
        },
        "country": {
            "title": "Country",
            "type": "string",
            "description": "Kode negara Shopee.",
            "editor": "select",
            "enum": [
                "ID",
                "SG",
                "MY",
                "TH",
                "PH",
                "VN",
                "TW",
                "BR"
            ],
            "enumTitles": [
                "Indonesia",
                "Singapore",
                "Malaysia",
                "Thailand",
                "Philippines",
                "Vietnam",
                "Taiwan",
                "Brazil"
            ],
            "default": "ID"
        },
        "maxItems": {
            "title": "Maximum Products per Keyword",
            "type": "integer",
            "description": "Target maksimum jumlah produk untuk setiap keyword.",
            "editor": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 200
        }
    },
    "required": [
        "keywords"
    ]
}
